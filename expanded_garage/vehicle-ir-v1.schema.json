{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:expanded-garage:vehicle-ir:1",
  "type": "object",
  "required": ["schema_version", "vehicle", "coordinate_system", "assets", "raw_members", "presentation", "sections"],
  "properties": {
    "schema_version": { "const": 1 },
    "vehicle": {
      "type": "object",
      "required": ["source_game", "source_id", "media_name"],
      "properties": {
        "source_game": { "type": "string", "minLength": 1 },
        "source_id": { "type": "integer", "minimum": 0 },
        "media_name": { "type": "string", "pattern": "^[A-Za-z0-9_]{1,64}$" }
      }
    },
    "coordinate_system": {
      "const": { "x": "right", "y": "up", "z": "forward", "length": "m", "triangle_order": "oriented triples" }
    },
    "assets": {
      "type": "object",
      "propertyNames": { "$ref": "#/$defs/digest" },
      "additionalProperties": {
        "type": "object",
        "required": ["path", "size", "sources"],
        "properties": {
          "path": { "type": "string", "pattern": "^blobs/[a-f0-9]{64}$" },
          "size": { "type": "integer", "minimum": 0 },
          "sources": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["container", "entry", "role"],
              "properties": {
                "container": { "type": "string", "minLength": 1 },
                "entry": { "type": "string", "minLength": 1 },
                "role": { "type": "string", "minLength": 1 }
              }
            }
          }
        }
      }
    },
    "raw_members": { "type": "array", "items": { "$ref": "#/$defs/named_record" } },
    "presentation": {
      "type": "object",
      "required": ["strings_en", "textures"],
      "properties": {
        "strings_en": {
          "type": "object",
          "additionalProperties": {
            "allOf": [{ "$ref": "#/$defs/record" }, {
              "required": ["value"],
              "properties": { "value": { "type": "string" } }
            }]
          }
        },
        "textures": { "type": "array", "items": { "$ref": "#/$defs/named_record" } }
      }
    },
    "source_tools": { "type": "object", "additionalProperties": { "$ref": "#/$defs/digest" } },
    "sections": {
      "type": "object",
      "required": ["geometry", "structure", "materials", "effects", "physics", "audio"],
      "additionalProperties": false,
      "properties": {
        "geometry": {
          "allOf": [{ "$ref": "#/$defs/section" }, {
            "properties": {
              "data": {
                "type": "object",
                "required": ["models", "opaque_models"],
                "properties": {
                  "models": { "type": "array", "items": { "$ref": "#/$defs/model" } },
                  "opaque_models": { "type": "array", "items": { "$ref": "#/$defs/named_record" } }
                }
              }
            }
          }]
        },
        "structure": { "$ref": "#/$defs/section" },
        "materials": { "$ref": "#/$defs/section" },
        "effects": { "$ref": "#/$defs/section" },
        "physics": { "$ref": "#/$defs/section" },
        "audio": { "$ref": "#/$defs/section" }
      }
    }
  },
  "$defs": {
    "digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "record": {
      "type": "object",
      "required": ["provenance"],
      "properties": {
        "provenance": {
          "type": "object",
          "required": ["asset", "locator", "units", "transforms"],
          "properties": {
            "asset": { "$ref": "#/$defs/digest" },
            "locator": { "type": "string", "minLength": 1 },
            "units": { "type": "string", "minLength": 1 },
            "transforms": { "type": "array", "items": { "type": "string" } }
          }
        }
      }
    },
    "named_record": {
      "allOf": [{ "$ref": "#/$defs/record" }, {
        "required": ["name"],
        "properties": { "name": { "type": "string", "minLength": 1 } }
      }]
    },
    "section": {
      "type": "object",
      "required": ["status", "limitations", "data"],
      "properties": {
        "status": { "enum": ["decoded", "partial", "opaque", "unavailable"] },
        "limitations": { "type": "array", "items": { "type": "string" } },
        "data": { "type": "object" }
      }
    },
    "vec3": {
      "type": "array", "items": { "type": "number" }, "minItems": 3, "maxItems": 3
    },
    "draw": {
      "allOf": [{ "$ref": "#/$defs/record" }, {
        "required": ["pool", "triangles", "count", "material", "lod", "uv_transform", "source_topology"],
        "properties": {
          "pool": { "type": "string" },
          "triangles": { "type": "string" },
          "count": { "type": "integer", "minimum": 1 },
          "material": { "type": "string" },
          "lod": { "type": "integer" },
          "uv_transform": { "type": "array", "items": { "type": "number" }, "minItems": 8, "maxItems": 8 },
          "source_topology": { "type": "integer" }
        }
      }]
    },
    "component": {
      "allOf": [{ "$ref": "#/$defs/named_record" }, {
        "required": ["offset", "bounds_min", "bounds_max", "pools", "draws"],
        "properties": {
          "offset": { "$ref": "#/$defs/vec3" },
          "bounds_min": { "$ref": "#/$defs/vec3" },
          "bounds_max": { "$ref": "#/$defs/vec3" },
          "pools": {
            "type": "object",
            "additionalProperties": {
              "type": "object",
              "required": ["count", "arrays"],
              "properties": {
                "count": { "type": "integer", "minimum": 1 },
                "arrays": {
                  "type": "object",
                  "required": ["position", "normal", "uv0", "uv1", "native_extra"],
                  "additionalProperties": { "type": "string" }
                }
              }
            }
          },
          "draws": { "type": "array", "items": { "$ref": "#/$defs/draw" } }
        }
      }]
    },
    "model": {
      "allOf": [{ "$ref": "#/$defs/record" }, {
        "required": ["raw", "member", "role", "components", "arrays", "arrays_sha256", "coverage"],
        "properties": {
          "raw": { "$ref": "#/$defs/digest" },
          "member": { "type": "string" },
          "role": { "enum": ["exterior", "exterior-near", "cockpit", "wheel", "caliper", "rotor"] },
          "components": { "type": "array", "items": { "$ref": "#/$defs/component" } },
          "arrays": { "type": "string", "pattern": "^geometry/[a-f0-9]{64}\\.npz$" },
          "arrays_sha256": { "$ref": "#/$defs/digest" },
          "coverage": {
            "type": "object",
            "required": ["declared_sections", "decoded_sections", "section_table_offset", "parsed_end", "issues"]
          }
        }
      }]
    }
  }
}
